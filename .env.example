# Query this exact variable names from the server. Never expose these values to the browser.

# MongoDB Atlas application database
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=mystical_drop_dev

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth — callback URL:
# http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional email (SMTP). If omitted in development, auth emails
# are captured by the local development mailbox at /dev/mailbox.
# Production requires SMTP; the development mailbox is never available there.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Mystical Drop <no-reply@example.com>
